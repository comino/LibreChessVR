# Compatibility proxy on the former host. The app is served by Nginx on janasven.
# Keep the sslip origin working for installed Quest wrappers and cached DNS clients.
librechessvr.com, parallax.46-224-133-201.sslip.io {
	encode gzip
	header -Server
	handle /.well-known/acme-challenge/* {
		reverse_proxy http://157.90.174.133 {
			header_up Host librechessvr.com
		}
	}
	handle {
		reverse_proxy https://157.90.174.133 {
			header_up Host librechessvr.com
			transport http {
				tls_server_name librechessvr.com
			}
		}
	}
}

www.librechessvr.com {
	handle /.well-known/acme-challenge/* {
		reverse_proxy http://157.90.174.133 {
			header_up Host {host}
		}
	}
	handle {
		redir https://librechessvr.com{uri} permanent
	}
}
