# LibreChessVR — /etc/caddy/Caddyfile on fred (auto-HTTPS).
# Keep the sslip host available for existing Quest wrappers.
librechessvr.com, parallax.46-224-133-201.sslip.io {
	root * /opt/parallax/web
	encode gzip
	# every app file revalidates (cheap 304s): a deploy is visible on the next load, never mixed
	header Cache-Control "no-cache"
	header /.well-known/assetlinks.json Content-Type application/json
	header /manifest.webmanifest Content-Type application/manifest+json
	file_server
}

www.librechessvr.com {
	redir https://librechessvr.com{uri} permanent
}
